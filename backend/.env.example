PORT=3000

# Docker PostgreSQL — matches docker-compose.yml defaults
POSTGRES_USER=dealflow
POSTGRES_PASSWORD=dealflow_pass
POSTGRES_DB=dealflow_db

DATABASE_URL="postgresql://dealflow:dealflow_pass@localhost:5432/dealflow_db"

JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

CLIENT_URL="http://localhost:5173"
