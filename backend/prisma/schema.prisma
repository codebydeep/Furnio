generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  ADMIN
  ACCOUNTANT
  USER
}

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

enum AccountType {
  ASSET
  LIABILITY
  EXPENSE
  INCOME
  CAPITAL
  PROFIT_AND_LOSS
  REVENUE
  OTHER_EXPENSE
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AnalyticType {
  INCOME
  EXPENSE
}

enum BudgetStatus {
  DRAFT
  CONFIRMED
  REVISED
  DONE
}

enum DocStatus {
  DRAFT
  CONFIRMED
  DONE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentDirection {
  RECEIVED
  SEND
}

// =========================
// USER
// =========================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  loginId   String   @unique
  email     String   @unique
  password  String
  role      UserRole
  contactId Int?     @unique
  contact   Contact? @relation(fields: [contactId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// CONTACT MASTER
// =========================

model Contact {
  id             Int               @id @default(autoincrement())
  name           String
  type           ContactType
  email          String?
  mobile         String?
  city           String?
  state          String?
  pincode        String?
  profileImage   String?
  archived       Boolean           @default(false)
  user           User?
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  journalEntries JournalEntry[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// =========================
// PRODUCT MASTER
// =========================

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  type       ProductType
  category   String?
  salesPrice Decimal     @db.Decimal(12, 2)
  cost       Decimal     @db.Decimal(12, 2)
  archived   Boolean     @default(false)
  poItems    POItem[]
  soItems    SOItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// =========================
// CHART OF ACCOUNTS
// =========================

model Account {
  id                 Int           @id @default(autoincrement())
  name               String
  type               AccountType
  archived           Boolean       @default(false)
  defaultForJournals Journal[]
  journalItems       JournalItem[]
  budgets            Budget[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

// =========================
// JOURNAL
// =========================

model Journal {
  id               Int          @id @default(autoincrement())
  name             String
  type             JournalType
  defaultAccountId Int?
  defaultAccount   Account?     @relation(fields: [defaultAccountId], references: [id])
  entries          JournalEntry[]
  payments         Payment[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// =========================
// JOURNAL ENTRY
// =========================

model JournalEntry {
  id             Int                @id @default(autoincrement())
  number         String             @unique
  journalId      Int
  journal        Journal            @relation(fields: [journalId], references: [id])
  partnerId      Int?
  partner        Contact?           @relation(fields: [partnerId], references: [id])
  accountingDate DateTime           @default(now())
  status         JournalEntryStatus @default(DRAFT)
  items          JournalItem[]
  createdBy      Int
  createdAt      DateTime           @default(now())
}

// =========================
// JOURNAL ITEM
// =========================

model JournalItem {
  id                Int              @id @default(autoincrement())
  journalEntryId    Int
  journalEntry      JournalEntry     @relation(fields: [journalEntryId], references: [id])
  accountId         Int
  account           Account          @relation(fields: [accountId], references: [id])
  partnerId         Int?
  debit             Decimal          @default(0) @db.Decimal(12, 2)
  credit            Decimal          @default(0) @db.Decimal(12, 2)
  analyticAccountId Int?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
}

// =========================
// ANALYTIC ACCOUNT
// =========================

model AnalyticAccount {
  id          Int           @id @default(autoincrement())
  name        String
  type        AnalyticType
  journalItems JournalItem[]
  budgets     Budget[]
  poItems     POItem[]
  soItems     SOItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// =========================
// BUDGET
// =========================

model Budget {
  id                Int          @id @default(autoincrement())
  name              String
  budgetType        String       @default("Project Budget")
  periodStart       DateTime
  periodEnd         DateTime
  responsiblePerson String
  status            BudgetStatus @default(DRAFT)
  analyticAccountId Int
  analyticAccount   AnalyticAccount @relation(fields: [analyticAccountId], references: [id])
  accountId         Int?
  account           Account?     @relation(fields: [accountId], references: [id])
  lines             BudgetLine[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model BudgetLine {
  id              Int      @id @default(autoincrement())
  budgetId        Int
  budget          Budget   @relation(fields: [budgetId], references: [id])
  startDate       DateTime
  endDate         DateTime
  committedAmount Decimal  @db.Decimal(12, 2)
  allocatedAmount Decimal  @db.Decimal(12, 2)
}

// =========================
// PURCHASE ORDER
// =========================

model PurchaseOrder {
  id       Int           @id @default(autoincrement())
  poNumber String        @unique
  vendorId Int
  vendor   Contact       @relation(fields: [vendorId], references: [id])
  poDate   DateTime      @default(now())
  status   DocStatus     @default(DRAFT)
  items    POItem[]
  bill     VendorBill?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model POItem {
  id                Int              @id @default(autoincrement())
  poId              Int
  po                PurchaseOrder    @relation(fields: [poId], references: [id])
  productId         Int
  product           Product          @relation(fields: [productId], references: [id])
  analyticAccountId Int?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  quantity          Int
  unitPrice         Decimal          @db.Decimal(12, 2)
}

// =========================
// VENDOR BILL
// =========================

model VendorBill {
  id             Int           @id @default(autoincrement())
  poId           Int           @unique
  po             PurchaseOrder @relation(fields: [poId], references: [id])
  billDate       DateTime      @default(now())
  dueDate        DateTime
  amount         Decimal       @db.Decimal(12, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  journalEntryId Int?
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// =========================
// SALES ORDER
// =========================

model SalesOrder {
  id         Int             @id @default(autoincrement())
  soNumber   String          @unique
  customerId Int
  customer   Contact         @relation(fields: [customerId], references: [id])
  soDate     DateTime        @default(now())
  status     DocStatus       @default(DRAFT)
  items      SOItem[]
  invoice    CustomerInvoice?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model SOItem {
  id                Int              @id @default(autoincrement())
  soId              Int
  so                SalesOrder       @relation(fields: [soId], references: [id])
  productId         Int
  product           Product          @relation(fields: [productId], references: [id])
  analyticAccountId Int?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  quantity          Int
  unitPrice         Decimal          @db.Decimal(12, 2)
  taxRate           Decimal          @default(0) @db.Decimal(5, 2)
}

// =========================
// CUSTOMER INVOICE
// =========================

model CustomerInvoice {
  id             Int           @id @default(autoincrement())
  soId           Int           @unique
  so             SalesOrder    @relation(fields: [soId], references: [id])
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime
  amount         Decimal       @db.Decimal(12, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  journalEntryId Int?
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// =========================
// PAYMENT
// =========================

model Payment {
  id                Int              @id @default(autoincrement())
  direction         PaymentDirection
  journalId         Int
  journal           Journal          @relation(fields: [journalId], references: [id])
  amount            Decimal          @db.Decimal(12, 2)
  date              DateTime         @default(now())
  vendorBillId      Int?
  vendorBill        VendorBill?      @relation(fields: [vendorBillId], references: [id])
  customerInvoiceId Int?
  customerInvoice   CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id])
  journalEntryId    Int?
  createdAt         DateTime         @default(now())
}
